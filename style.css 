* {
  box-sizing: border-box;
}

:root {
  --bg: #080914;
  --card: rgba(255, 255, 255, 0.08);
  --card-strong: rgba(255, 255, 255, 0.13);
  --text: #f8fafc;
  --muted: #a1a1aa;
  --line: rgba(255, 255, 255, 0.12);
  --accent: #a78bfa;
  --accent2: #38bdf8;
  --danger: #fb7185;
  --shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
}

body.light {
  --bg: #f5f7fb;
  --card: rgba(255, 255, 255, 0.82);
  --card-strong: rgba(255, 255, 255, 0.96);
  --text: #111827;
  --muted: #6b7280;
  --line: rgba(17, 24, 39, 0.1);
  --shadow: 0 24px 70px rgba(15, 23, 42, 0.12);
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background:
    radial-gradient(circle at top left, rgba(167, 139, 250, 0.35), transparent 32%),
    radial-gradient(circle at top right, rgba(56, 189, 248, 0.24), transparent 32%),
    radial-gradient(circle at bottom, rgba(244, 114, 182, 0.16), transparent 36%),
    var(--bg);
  color: var(--text);
}

.hidden {
  display: none !important;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  border: 0;
  border-radius: 16px;
  padding: 13px 16px;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  color: white;
  font-weight: 800;
  cursor: pointer;
  box-shadow: 0 14px 34px rgba(99, 102, 241, 0.28);
}

button:hover {
  transform: translateY(-1px);
}

.secondary,
#themeToggle {
  background: var(--card-strong);
  color: var(--text);
  border: 1px solid var(--line);
  box-shadow: none;
}

.danger {
  background: linear-gradient(135deg, #e11d48, var(--danger));
}

input,
select,
textarea {
  width: 100%;
  margin: 8px 0;
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 14px 15px;
  background: rgba(255, 255, 255, 0.08);
  color: var(--text);
  outline: none;
}

body.light input,
body.light select,
body.light textarea {
  background: white;
}

textarea {
  min-height: 110px;
  resize: vertical;
}

.login-page {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
}

.login-shell {
  width: min(1150px, 100%);
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  gap: 22px;
}

.login-left,
.login-card,
.sidebar,
.panel,
.stat,
.live-card {
  background: var(--card);
  border: 1px solid var(--line);
  backdrop-filter: blur(22px);
  box-shadow: var(--shadow);
}

.login-left {
  min-height: 620px;
  border-radius: 38px;
  padding: 42px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.logo {
  font-size: 18px;
  font-weight: 950;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--accent2);
}

.login-left h1 {
  max-width: 720px;
  margin: 26px 0 14px;
  font-size: clamp(48px, 7vw, 88px);
  line-height: 0.88;
  letter-spacing: -0.075em;
}

.login-left p {
  max-width: 620px;
  color: var(--muted);
  font-size: 18px;
  line-height: 1.7;
}

.login-card {
  border-radius: 38px;
  padding: 34px;
  align-self: stretch;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.login-card h2 {
  margin: 0;
  font-size: 36px;
  letter-spacing: -0.05em;
}

.login-card p,
#loginMessage {
  color: var(--muted);
}

.dashboard {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 250px 1fr;
  gap: 18px;
  padding: 18px;
}

.sidebar {
  border-radius: 30px;
  padding: 24px;
  position: sticky;
  top: 18px;
  height: calc(100vh - 36px);
}

.sidebar h2 {
  margin: 0;
  font-size: 26px;
  letter-spacing: -0.05em;
}

.sidebar p {
  color: var(--muted);
}

.sidebar button {
  width: 100%;
  margin-top: 12px;
}

.content {
  min-width: 0;
}

.topbar {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  align-items: center;
  margin-bottom: 18px;
}

.eyebrow {
  margin: 0 0 8px;
  color: var(--accent2);
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 12px;
}

.topbar h1 {
  margin: 0;
  font-size: clamp(32px, 5vw, 54px);
  line-height: 1;
  letter-spacing: -0.06em;
}

.live-card {
  min-width: 250px;
  border-radius: 24px;
  padding: 18px;
}

.live-card span {
  display: block;
  color: var(--muted);
  font-size: 13px;
  margin-bottom: 7px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 14px;
}

.stat {
  border-radius: 24px;
  padding: 20px;
}

.stat p {
  margin: 0 0 8px;
  color: var(--muted);
}

.stat h2 {
  margin: 0;
  font-size: 34px;
  letter-spacing: -0.05em;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-bottom: 14px;
}

.panel {
  border-radius: 28px;
  padding: 22px;
}

.panel h2 {
  margin: 0 0 14px;
  letter-spacing: -0.04em;
}

.hero-panel {
  background:
    linear-gradient(145deg, rgba(167, 139, 250, 0.18), rgba(56, 189, 248, 0.1)),
    var(--card);
}

.wide {
  grid-column: span 2;
}

#taskList,
#historyList,
#announcementList,
#goalList,
#deadlineList,
#achievementList,
#rolesList,
#teamProductivity {
  display: grid;
  gap: 10px;
  margin-top: 12px;
}

.item,
.task-card,
.history-card {
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.07);
}

body.light .item,
body.light .task-card,
body.light .history-card {
  background: rgba(255, 255, 255, 0.9);
}

.task-card {
  display: grid;
  gap: 10px;
}

.badges {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.badge,
.chip {
  width: fit-content;
  padding: 7px 10px;
  border-radius: 999px;
  background: rgba(167, 139, 250, 0.18);
  color: var(--text);
  font-size: 12px;
  font-weight: 800;
}

.task-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.task-actions button {
  width: fit-content;
  min-height: 38px;
  padding: 9px 12px;
  font-size: 13px;
}

.bar-row {
  margin: 12px 0;
}

.bar-label {
  display: flex;
  justify-content: space-between;
  color: var(--muted);
  font-size: 13px;
  margin-bottom: 7px;
}

.bar-track {
  height: 12px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.1);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  width: 0%;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--accent), var(--accent2));
}

@media (max-width: 980px) {
  .login-shell,
  .dashboard,
  .grid,
  .stats {
    grid-template-columns: 1fr;
  }

  .sidebar {
    position: static;
    height: auto;
  }

  .wide {
    grid-column: auto;
  }

  .topbar {
    flex-direction: column;
    align-items: stretch;
  }

  .live-card {
    min-width: 0;
  }

  .login-left {
    min-height: 430px;
  }
}

@media (max-width: 520px) {
  .login-page,
  .dashboard {
    padding: 10px;
  }

  .login-left,
  .login-card,
  .sidebar,
  .panel,
  .stat,
  .live-card {
    border-radius: 22px;
  }

  .login-left,
  .login-card,
  .panel,
  .sidebar {
    padding: 18px;
  }

  .login-left h1 {
    font-size: 46px;
  }

  button {
    width: 100%;
  }

  .task-actions {
    display: grid;
  }
}