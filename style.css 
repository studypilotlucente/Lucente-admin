* {
  box-sizing: border-box;
}

:root {
  --text: #18181b;
  --muted: #71717a;
  --soft: rgba(255, 255, 255, 0.72);
  --border: rgba(255, 255, 255, 0.72);
  --shadow: 0 24px 80px rgba(24, 24, 27, 0.12);
  --purple: #8b5cf6;
  --pink: #f0abfc;
  --blue: #bfdbfe;
  --grey: #f4f4f5;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
  color: var(--text);
  background:
    linear-gradient(135deg, #fafafa 0%, #eceef3 45%, #f8f7ff 100%);
  overflow-x: hidden;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  background:
    radial-gradient(circle at 18% 10%, rgba(240, 171, 252, 0.45), transparent 28%),
    radial-gradient(circle at 86% 18%, rgba(191, 219, 254, 0.55), transparent 30%),
    radial-gradient(circle at 55% 90%, rgba(221, 214, 254, 0.6), transparent 35%);
  pointer-events: none;
  z-index: -3;
}

.orb {
  position: fixed;
  border-radius: 999px;
  filter: blur(10px);
  opacity: 0.45;
  z-index: -2;
}

.orb-one {
  width: 280px;
  height: 280px;
  background: #f5d0fe;
  top: -80px;
  left: -80px;
}

.orb-two {
  width: 330px;
  height: 330px;
  background: #dbeafe;
  right: -100px;
  top: 100px;
}

.orb-three {
  width: 240px;
  height: 240px;
  background: #e9d5ff;
  bottom: -80px;
  left: 38%;
}

.app-shell {
  width: 100%;
  min-height: 100vh;
  padding: 28px;
}

.hidden {
  display: none !important;
}

/* LOGIN */

.login-page {
  min-height: calc(100vh - 56px);
  display: grid;
  place-items: center;
}

.login-layout {
  width: min(1120px, 100%);
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 24px;
  align-items: stretch;
}

.hero-content,
.login-card,
.panel,
.stat-card {
  background: rgba(255, 255, 255, 0.68);
  border: 1px solid rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
  box-shadow: var(--shadow);
}

.hero-content {
  min-height: 620px;
  border-radius: 42px;
  padding: 48px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  position: relative;
  overflow: hidden;
}

.hero-content::before {
  content: "";
  position: absolute;
  width: 420px;
  height: 420px;
  border-radius: 999px;
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.16), rgba(240, 171, 252, 0.2));
  top: -120px;
  right: -120px;
}

.logo-mark {
  position: absolute;
  top: 34px;
  left: 34px;
  width: 58px;
  height: 58px;
  border-radius: 20px;
  display: grid;
  place-items: center;
  font-size: 28px;
  font-weight: 900;
  color: white;
  background: linear-gradient(135deg, #18181b, #8b5cf6);
  box-shadow: 0 16px 36px rgba(139, 92, 246, 0.28);
}

.eyebrow {
  margin: 0 0 12px;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  font-size: 12px;
  font-weight: 900;
  color: var(--purple);
}

h1 {
  max-width: 720px;
  margin: 0;
  font-size: clamp(48px, 7vw, 88px);
  line-height: 0.9;
  letter-spacing: -0.075em;
}

h2 {
  margin: 0;
  font-size: clamp(30px, 4vw, 46px);
  line-height: 1;
  letter-spacing: -0.055em;
}

h3 {
  margin: 0 0 12px;
  font-size: 22px;
  letter-spacing: -0.035em;
}

.subtitle {
  max-width: 650px;
  margin: 22px 0 0;
  font-size: 18px;
  line-height: 1.65;
  color: var(--muted);
}

.muted {
  margin: 0 0 18px;
  color: var(--muted);
  line-height: 1.6;
}

.feature-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 28px;
}

.feature-pill,
.chip,
.badge {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  border-radius: 999px;
  font-weight: 800;
}

.feature-pill {
  padding: 11px 15px;
  background: rgba(255, 255, 255, 0.74);
  border: 1px solid rgba(255, 255, 255, 0.9);
  color: #3f3f46;
}

.login-card {
  border-radius: 42px;
  padding: 42px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.login-box {
  display: grid;
  gap: 14px;
}

/* FORMS */

input,
select,
textarea {
  width: 100%;
  min-height: 52px;
  margin-bottom: 12px;
  border: 1px solid rgba(212, 212, 216, 0.9);
  background: rgba(255, 255, 255, 0.82);
  border-radius: 18px;
  padding: 15px 16px;
  color: #18181b;
  font-size: 15px;
  outline: none;
  transition: 0.2s ease;
}

textarea {
  min-height: 118px;
  resize: vertical;
}

input::placeholder,
textarea::placeholder {
  color: #a1a1aa;
}

input:focus,
select:focus,
textarea:focus {
  border-color: rgba(139, 92, 246, 0.72);
  box-shadow: 0 0 0 5px rgba(139, 92, 246, 0.12);
  background: white;
}

button {
  width: 100%;
  min-height: 52px;
  border: none;
  border-radius: 18px;
  padding: 14px 18px;
  color: white;
  background: linear-gradient(135deg, #18181b, #7c3aed);
  font-size: 15px;
  font-weight: 900;
  cursor: pointer;
  box-shadow: 0 16px 34px rgba(124, 58, 237, 0.22);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

button:hover {
  transform: translateY(-2px);
  box-shadow: 0 20px 40px rgba(124, 58, 237, 0.26);
}

.secondary-btn {
  background: rgba(255, 255, 255, 0.78);
  color: #18181b;
  border: 1px solid rgba(212, 212, 216, 0.85);
  box-shadow: none;
}

.danger-btn {
  background: linear-gradient(135deg, #be123c, #fb7185);
  box-shadow: 0 16px 34px rgba(244, 63, 94, 0.18);
}

.message {
  min-height: 22px;
  margin: 0;
  color: #7c3aed;
  font-weight: 800;
  line-height: 1.5;
}

/* DASHBOARD */

.dashboard {
  width: min(1180px, 100%);
  margin: 0 auto;
  padding: 8px 0 48px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  margin: 12px 0 24px;
  padding: 24px;
  border-radius: 32px;
  background: rgba(255, 255, 255, 0.45);
  border: 1px solid rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(18px);
}

.logout-btn {
  width: auto;
  min-width: 130px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  margin-bottom: 18px;
}

.stat-card {
  position: relative;
  padding: 24px;
  border-radius: 30px;
  overflow: hidden;
}

.stat-card::after {
  content: "";
  position: absolute;
  width: 110px;
  height: 110px;
  right: -38px;
  bottom: -38px;
  border-radius: 999px;
  background: rgba(139, 92, 246, 0.1);
}

.stat-icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  margin-bottom: 18px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.82);
  font-size: 20px;
}

.stat-card p {
  margin: 0 0 8px;
  color: var(--muted);
  font-weight: 700;
}

.stat-card h3 {
  margin: 0;
  font-size: clamp(24px, 3vw, 34px);
}

.grid-layout {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 18px;
  margin-bottom: 18px;
}

.panel {
  padding: 24px;
  border-radius: 30px;
}

.premium-panel {
  background:
    linear-gradient(145deg, rgba(255,255,255,0.76), rgba(245,243,255,0.74));
}

.panel-header,
.section-title {
  margin-bottom: 14px;
}

.wide-panel {
  margin-bottom: 18px;
}

.button-row {
  display: flex;
  gap: 12px;
}

.button-row button {
  flex: 1;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 12px;
}

.chip {
  padding: 9px 12px;
  background: rgba(244, 244, 245, 0.9);
  color: #3f3f46;
  font-size: 13px;
}

.task-list,
.history-list {
  display: grid;
  gap: 12px;
}

.task-card,
.history-card {
  border-radius: 24px;
  padding: 18px;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(228, 228, 231, 0.8);
}

.task-card {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 16px;
  align-items: center;
}

.badge {
  margin: 4px 6px 0 0;
  padding: 7px 10px;
  background: #f3e8ff;
  color: #6d28d9;
  font-size: 12px;
}

.small-btn {
  min-height: 42px;
  width: auto;
  padding: 10px 13px;
  border-radius: 14px;
  font-size: 13px;
}

/* IPHONE + TABLET */

@media (max-width: 950px) {
  .app-shell {
    padding: 18px;
  }

  .login-layout {
    grid-template-columns: 1fr;
  }

  .hero-content {
    min-height: auto;
    padding: 110px 28px 32px;
    border-radius: 34px;
  }

  .login-card {
    padding: 28px;
    border-radius: 34px;
  }

  .stats-grid,
  .grid-layout {
    grid-template-columns: 1fr;
  }

  .topbar {
    align-items: stretch;
    flex-direction: column;
  }

  .logout-btn {
    width: 100%;
  }

  .task-card {
    grid-template-columns: 1fr;
  }

  .button-row {
    flex-direction: column;
  }

  .small-btn {
    width: 100%;
  }
}

@media (max-width: 520px) {
  .app-shell {
    padding: 12px;
  }

  .login-page {
    min-height: calc(100vh - 24px);
  }

  .hero-content,
  .login-card,
  .panel,
  .stat-card,
  .topbar {
    border-radius: 26px;
  }

  .hero-content {
    padding: 96px 22px 26px;
  }

  .logo-mark {
    top: 24px;
    left: 24px;
    width: 52px;
    height: 52px;
    border-radius: 18px;
  }

  h1 {
    font-size: 46px;
  }

  h2 {
    font-size: 32px;
  }

  .subtitle {
    font-size: 16px;
  }

  .feature-row {
    gap: 8px;
  }

  .feature-pill {
    font-size: 13px;
    padding: 9px 12px;
  }

  .login-card,
  .panel,
  .stat-card,
  .topbar {
    padding: 20px;
  }

  input,
  select,
  textarea,
  button {
    border-radius: 16px;
    font-size: 15px;
  }
}