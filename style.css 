* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --bg: #050714;
  --bg2: #090d1d;
  --card: rgba(13, 18, 34, 0.78);
  --card2: rgba(21, 27, 48, 0.78);
  --line: rgba(255, 255, 255, 0.11);
  --text: #ffffff;
  --muted: #aeb6c8;
  --purple: #7c3aed;
  --violet: #a855f7;
  --blue: #3b82f6;
  --pink: #ec4899;
  --green: #22c55e;
  --orange: #fb923c;
  --red: #fb7185;
}

body {
  min-height: 100vh;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background:
    radial-gradient(circle at 78% 2%, rgba(124, 58, 237, 0.42), transparent 28%),
    radial-gradient(circle at 42% 18%, rgba(59, 130, 246, 0.16), transparent 30%),
    linear-gradient(135deg, var(--bg), var(--bg2));
  color: var(--text);
  overflow-x: hidden;
}

body::before {
  content: "";
  position: fixed;
  top: 28px;
  right: 80px;
  width: 460px;
  height: 90px;
  border-radius: 999px;
  background: linear-gradient(90deg, transparent, rgba(124, 58, 237, 0.65), rgba(59, 130, 246, 0.55), transparent);
  filter: blur(18px);
  transform: rotate(-5deg);
  pointer-events: none;
}

.hidden {
  display: none !important;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  border: none;
  color: white;
  cursor: pointer;
  border-radius: 14px;
  padding: 13px 16px;
  font-weight: 800;
  background: linear-gradient(135deg, #6d5dfc, #9b4dff);
  box-shadow: 0 14px 32px rgba(124, 58, 237, 0.26);
}

button:hover {
  transform: translateY(-1px);
}

.secondary,
.icon-btn {
  background: rgba(255, 255, 255, 0.07);
  border: 1px solid var(--line);
  box-shadow: none;
}

.danger {
  background: linear-gradient(135deg, rgba(251, 113, 133, 0.75), rgba(127, 29, 29, 0.55));
}

input,
select,
textarea {
  width: 100%;
  margin: 8px 0;
  border: 1px solid var(--line);
  background: rgba(5, 9, 20, 0.65);
  color: white;
  outline: none;
  border-radius: 14px;
  padding: 14px;
}

textarea {
  min-height: 95px;
  resize: vertical;
}

/* LOGIN */

.login-page {
  min-height: 100vh;
  padding: 24px;
  display: grid;
  place-items: center;
}

.login-shell {
  width: min(1180px, 100%);
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 22px;
}

.login-visual,
.login-card {
  border: 1px solid var(--line);
  background: var(--card);
  backdrop-filter: blur(24px);
  box-shadow: 0 28px 90px rgba(0, 0, 0, 0.45);
}

.login-visual {
  min-height: 620px;
  border-radius: 36px;
  padding: 42px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  position: relative;
  overflow: hidden;
}

.login-visual::after {
  content: "";
  position: absolute;
  inset: 120px 30px 30px;
  border-radius: 28px;
  background:
    radial-gradient(circle at 70% 25%, rgba(236, 72, 153, 0.7), transparent 25%),
    radial-gradient(circle at 68% 70%, rgba(124, 58, 237, 0.75), transparent 30%),
    linear-gradient(135deg, #101935, #070a13);
  opacity: 0.55;
  z-index: -1;
}

.brand-word {
  letter-spacing: 0.35em;
  font-weight: 900;
  font-size: 18px;
}

.small-title {
  margin-top: 8px;
  color: var(--muted);
  font-size: 11px;
  letter-spacing: 0.25em;
}

.login-visual h1 {
  max-width: 680px;
  margin-top: 30px;
  font-size: clamp(48px, 8vw, 92px);
  line-height: 0.9;
  letter-spacing: -0.07em;
}

.login-visual p {
  max-width: 560px;
  margin-top: 18px;
  color: var(--muted);
  line-height: 1.7;
  font-size: 18px;
}

.login-card {
  border-radius: 36px;
  padding: 38px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.login-card h2 {
  font-size: 38px;
  letter-spacing: -0.05em;
}

.login-card p,
#loginMessage {
  color: var(--muted);
  margin: 10px 0 16px;
}

/* DASHBOARD */

.dashboard {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 250px 1fr;
}

.sidebar {
  min-height: 100vh;
  padding: 32px 24px;
  background: rgba(2, 6, 23, 0.62);
  border-right: 1px solid var(--line);
}

.nav {
  display: grid;
  gap: 12px;
  margin-top: 34px;
}

.nav a {
  padding: 14px 15px;
  border-radius: 14px;
  color: var(--muted);
  text-decoration: none;
}

.nav a.active {
  color: white;
  background: linear-gradient(135deg, rgba(109, 93, 252, 0.85), rgba(124, 58, 237, 0.5));
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.side-card {
  margin-top: 130px;
  border-radius: 22px;
  padding: 22px;
  background:
    radial-gradient(circle at 60% 10%, rgba(168, 85, 247, 0.55), transparent 30%),
    rgba(16, 24, 44, 0.88);
  border: 1px solid rgba(168, 85, 247, 0.35);
}

.lucente-icon {
  width: 58px;
  height: 58px;
  border-radius: 18px;
  display: grid;
  place-items: center;
  font-size: 28px;
  font-weight: 900;
  margin-bottom: 20px;
  background: linear-gradient(135deg, #6d5dfc, #ec4899);
}

.side-card p,
.profile-mini p,
.topbar p,
.panel p,
.stat p {
  color: var(--muted);
}

.profile-mini {
  margin-top: 26px;
  padding: 16px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  gap: 12px;
  background: rgba(255, 255, 255, 0.055);
  border: 1px solid var(--line);
}

.avatar {
  width: 38px;
  height: 38px;
  border-radius: 999px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #6d5dfc, #a855f7);
  font-weight: 900;
}

.sidebar button {
  width: 100%;
  margin-top: 14px;
}

.content {
  padding: 34px;
  min-width: 0;
}

.topbar {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: flex-start;
  margin-bottom: 24px;
}

.topbar h1 {
  font-size: clamp(28px, 4vw, 42px);
  letter-spacing: -0.055em;
}

.icon-btn {
  width: 52px;
  height: 52px;
  border-radius: 999px;
}

/* HERO */

.hero-banner {
  min-height: 220px;
  border-radius: 22px;
  padding: 42px;
  margin-bottom: 22px;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  border: 1px solid var(--line);
  background:
    linear-gradient(90deg, rgba(10, 16, 32, 0.92), rgba(10, 16, 32, 0.25)),
    radial-gradient(circle at 76% 38%, rgba(236, 72, 153, 0.75), transparent 22%),
    radial-gradient(circle at 73% 75%, rgba(124, 58, 237, 0.75), transparent 30%),
    linear-gradient(135deg, #111a38, #050714);
}

.hero-banner::after {
  content: "";
  position: absolute;
  right: 120px;
  bottom: 24px;
  width: 240px;
  height: 110px;
  border-radius: 26px;
  border: 2px solid rgba(255,255,255,0.18);
  background:
    linear-gradient(135deg, rgba(255,255,255,0.22), rgba(255,255,255,0.03));
  box-shadow: 0 30px 60px rgba(0,0,0,.3);
}

.hero-banner h2 {
  font-size: 30px;
  margin-bottom: 12px;
}

.hero-banner p {
  max-width: 390px;
  line-height: 1.6;
}

/* CARDS */

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-bottom: 22px;
}

.stat,
.panel {
  background: var(--card);
  border: 1px solid var(--line);
  backdrop-filter: blur(24px);
  box-shadow: 0 18px 60px rgba(0,0,0,.25);
}

.stat {
  border-radius: 22px;
  padding: 22px;
}

.stat-icon {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  margin-bottom: 14px;
  background: linear-gradient(135deg, #6d5dfc, #a855f7);
}

.stat h2 {
  font-size: 26px;
  margin-top: 8px;
  letter-spacing: -0.04em;
}

.main-grid {
  display: grid;
  grid-template-columns: 1fr 1.2fr 0.9fr;
  gap: 18px;
  margin-bottom: 18px;
}

.bottom-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.panel {
  border-radius: 22px;
  padding: 22px;
}

.panel h2 {
  font-size: 20px;
  margin-bottom: 12px;
}

.button-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

/* ITEMS */

#taskList,
#historyList,
#announcementList,
#goalList,
#deadlineList,
#achievementList,
#rolesList,
#teamProductivity,
#weeklyChart {
  display: grid;
  gap: 10px;
  margin-top: 14px;
}

.task-card,
.history-card,
.item {
  padding: 14px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.055);
  border: 1px solid var(--line);
}

.badges,
.task-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 8px;
}

.badge,
.chip {
  width: fit-content;
  padding: 7px 10px;
  border-radius: 999px;
  background: rgba(124, 58, 237, 0.25);
  color: white;
  font-size: 12px;
  font-weight: 800;
}

.task-actions button {
  width: fit-content;
  padding: 9px 12px;
  font-size: 12px;
}

.bar-row {
  display: grid;
  gap: 8px;
}

.bar-label {
  display: flex;
  justify-content: space-between;
  color: var(--muted);
  font-size: 13px;
}

.bar-track {
  height: 10px;
  border-radius: 999px;
  background: rgba(255,255,255,.08);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #6d5dfc, #a855f7, #3b82f6);
}

.wide-panel {
  grid-column: span 3;
}

/* MOBILE */

@media (max-width: 1050px) {
  .dashboard {
    grid-template-columns: 1fr;
  }

  .sidebar {
    min-height: auto;
  }

  .side-card {
    margin-top: 24px;
  }

  .stats,
  .main-grid,
  .bottom-grid,
  .login-shell {
    grid-template-columns: 1fr;
  }

  .wide-panel {
    grid-column: auto;
  }

  .hero-banner::after {
    display: none;
  }
}

@media (max-width: 560px) {
  .content,
  .sidebar,
  .login-page {
    padding: 14px;
  }

  .hero-banner,
  .panel,
  .stat,
  .login-card,
  .login-visual {
    border-radius: 18px;
    padding: 18px;
  }

  .login-visual {
    min-height: 420px;
  }

  .login-visual h1 {
    font-size: 48px;
  }

  .button-row {
    grid-template-columns: 1fr;
  }
}