*{
margin:0;
padding:0;
box-sizing:border-box;
}

:root{
--bg:#050816;
--card:rgba(14,18,35,.75);
--border:rgba(255,255,255,.08);
--text:#ffffff;
--muted:#9ca3af;
--purple:#8b5cf6;
--blue:#3b82f6;
--pink:#ec4899;
--shadow:0 25px 80px rgba(0,0,0,.45);
}

body{
font-family:Inter,-apple-system,BlinkMacSystemFont,sans-serif;
background:
radial-gradient(circle at top left,#8b5cf630,transparent 25%),
radial-gradient(circle at top right,#3b82f620,transparent 30%),
linear-gradient(135deg,#050816,#0d1025,#060812);

color:var(--text);
min-height:100vh;
overflow-x:hidden;
padding:20px;
}

.hidden{
display:none!important;
}

.login-shell{
display:grid;
grid-template-columns:1.2fr .8fr;
gap:30px;
max-width:1400px;
margin:auto;
min-height:95vh;
align-items:center;
}

.login-left,
.login-card,
.sidebar,
.panel,
.stat,
.live-card{
background:var(--card);
backdrop-filter:blur(25px);
border:1px solid var(--border);
box-shadow:var(--shadow);
}

.login-left{
border-radius:35px;
padding:60px;
display:flex;
flex-direction:column;
justify-content:flex-end;
position:relative;
overflow:hidden;
}

.login-left::before{
content:"";
position:absolute;
height:500px;
width:500px;
right:-200px;
top:-150px;
border-radius:50%;
background:
linear-gradient(
135deg,
#8b5cf6,
#3b82f6
);
opacity:.3;
filter:blur(100px);
}

.logo{
font-size:18px;
letter-spacing:6px;
font-weight:800;
margin-bottom:40px;
}

.login-left h1{
font-size:clamp(50px,8vw,100px);
line-height:.9;
margin-bottom:20px;
letter-spacing:-4px;
}

.login-left p{
font-size:18px;
max-width:600px;
color:var(--muted);
line-height:1.7;
}

.login-card{
border-radius:35px;
padding:45px;
}

.login-card h2{
font-size:42px;
margin-bottom:10px;
}

.login-card p{
margin-bottom:20px;
color:var(--muted);
}

input,
textarea,
select{
width:100%;
margin:10px 0;
padding:16px;
border-radius:18px;
border:none;
background:rgba(255,255,255,.06);
color:white;
outline:none;
}

button{
width:100%;
padding:15px;
border:none;
border-radius:18px;
cursor:pointer;
margin-top:10px;
font-weight:700;
font-size:15px;

background:
linear-gradient(
135deg,
#8b5cf6,
#3b82f6
);

color:white;
}

.secondary{
background:rgba(255,255,255,.08);
}

.dashboard{
display:grid;
grid-template-columns:260px 1fr;
gap:20px;
}

.sidebar{
border-radius:30px;
padding:25px;
height:calc(100vh - 40px);
position:sticky;
top:20px;
}

.content{
width:100%;
}

.topbar{
display:flex;
justify-content:space-between;
margin-bottom:20px;
gap:20px;
}

.topbar h1{
font-size:48px;
letter-spacing:-2px;
}

.live-card{
padding:20px;
border-radius:25px;
min-width:280px;
}

.stats{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:15px;
margin-bottom:15px;
}

.stat{
padding:25px;
border-radius:25px;
}

.stat h2{
font-size:38px;
margin-top:10px;
}

.grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:15px;
margin-bottom:15px;
}

.panel{
padding:25px;
border-radius:30px;
}

.hero-panel{
background:
linear-gradient(
135deg,
rgba(139,92,246,.2),
rgba(59,130,246,.1)
);
}

.wide{
grid-column:span 2;
}

.task-card,
.history-card,
.item{
padding:15px;
border-radius:18px;
background:rgba(255,255,255,.05);
margin-top:10px;
}

.badges{
display:flex;
gap:8px;
flex-wrap:wrap;
margin-top:10px;
}

.badge{
padding:7px 12px;
border-radius:999px;
font-size:12px;
background:#8b5cf630;
}

@media(max-width:1000px){

.login-shell,
.dashboard,
.stats,
.grid{
grid-template-columns:1fr;
}

.sidebar{
height:auto;
position:relative;
}

.login-left{
min-height:400px;
}

.wide{
grid-column:auto;
}

.topbar{
flex-direction:column;
}

}

@media(max-width:600px){

body{
padding:10px;
}

.login-left h1{
font-size:50px;
}

.login-left,
.login-card,
.sidebar,
.panel{
padding:20px;
border-radius:25px;
}

}